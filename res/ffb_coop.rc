// Version resource and icon for FFB Co-op.exe (Explorer: Properties -> Details).
// The dev exe (#26) builds this same file with FFB_DEV_CHANNEL defined, so its
// names and version come from the dev side of ffb_version.h.
#include <winver.h>
#include "ffb_version.h"

// Explorer takes the first icon group in the resource table as the exe's icon,
// so it keeps the lowest id. The FFB brand icon by Jals (CREDITS.md), the transparent
// bunny, byte-for-byte a copy of Fluffy-Fluffy-and-Bouncy/mewgenics-coop
// res/brand/ffb.ico (its #2523, sha256
// 05d8ea067cc9349d5f9fdb695cefa5247b637409299d15b4eaf40ad863754874): 16, 24, 32, 48,
// 64, 128 and 256 px, every frame PNG-compressed. Rebuild it there with its
// res/brand/make_icons.py and copy it here; CMakeLists.txt relinks on a change.
1 ICON "ffb_coop.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FFB_VERSION_MAJOR,FFB_VERSION_MINOR,FFB_VERSION_PATCH,0
 PRODUCTVERSION FFB_VERSION_MAJOR,FFB_VERSION_MINOR,FFB_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"          // US English, Unicode
        BEGIN
            VALUE "CompanyName",      FFB_PRODUCT_NAME
            VALUE "FileDescription",  FFB_PRODUCT_NAME
            VALUE "FileVersion",      FFB_VERSION_STR
            VALUE "InternalName",     "ffb_coop"
            VALUE "OriginalFilename", FFB_EXE_NAME
            VALUE "ProductName",      FFB_PRODUCT_NAME
            VALUE "ProductVersion",   FFB_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
